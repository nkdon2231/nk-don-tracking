# Public site URL used for canonical links, QR codes, and Open Graph.
# Example: https://www.nkdon.com
NEXT_PUBLIC_SITE_URL=

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string (pooler or direct).
# This is the production database. Do not point it at a temporary sandbox database.
DATABASE_URL=

# Required to create the first administrator. Use a long random value.
# After the first super admin exists, the setup route closes itself.
SETUP_TOKEN=

# Optional extra signing material for session cookies if you rotate independently of the database.
# Sessions are stored server-side; this is not a substitute for the database.
SESSION_SECRET=

# Local preview only. Ignored when NODE_ENV=production.
# ALLOW_DEMO_SEED=true
# DEMO_ADMIN_PASSWORD=

# Optional later notification providers. Leave blank until a real provider is connected.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMS_PROVIDER_URL=
# WHATSAPP_PROVIDER_URL=

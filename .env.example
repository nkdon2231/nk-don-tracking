# Names the server already reads. Set them in Vercel. Do not commit values.
# The current Vercel Supabase integration uses the aliases in parentheses.
# Either name works. DATABASE_URL is preferred over POSTGRES_URL when both exist.

# Canonical public URL for links and QR codes.
# Leave unset to keep using the current Vercel hostname.
# When qcorvazent.com is connected, set: https://qcorvazent.com
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (or SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Safe for the server password check.
# Aliases: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
# Alias: SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string (session or direct, not a sandbox database).
# Aliases, in order: POSTGRES_URL, POSTGRES_URL_NON_POOLING, POSTGRES_PRISMA_URL
DATABASE_URL=

# Required to create the first administrator. Long random value.
# After the first super admin exists, /admin/setup closes itself.
SETUP_TOKEN=

# Optional extra signing material. Sessions are stored in the database.
# SESSION_SECRET=

# Local preview only. Ignored when NODE_ENV=production.
# ALLOW_DEMO_SEED=true
# DEMO_ADMIN_PASSWORD=

# Optional notification providers. Leave blank until a real provider is connected.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMS_PROVIDER_URL=
# WHATSAPP_PROVIDER_URL=
